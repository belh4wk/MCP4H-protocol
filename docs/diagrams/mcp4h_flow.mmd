flowchart LR
  subgraph Sources[Sources]
    A[Simulation / machine telemetry]
    B[Software / MCP events]
    C[Voice / gaze / controls]
    D[Sensors / environment]
  end

  subgraph Semantics[MCP4H semantic records]
    E[Observation record(s)]
    F[Interpretation record(s)]
  end

  subgraph Decision[Optional decision + projection]
    G[Policy record(s)]
    H[Projection record(s)]
    CP[Capability Profile]
  end

  subgraph Delivery[Delivery]
    I[Transport / bridge]
    J[Renderer]
  end

  subgraph Receivers[Receivers]
    K[Person / operator]
    L[Software / AI]
    M[Device / system]
  end

  A --> E
  B --> E
  C --> E
  D --> E

  E --> F
  F --> G
  F --> H
  G --> H
  CP --> H
  H --> I
  I --> J

  J --> K
  J --> L
  J --> M

  K -. response .-> R[Response record]
  L -. response .-> R
  M -. response .-> R
  R -. may become new observation .-> E
